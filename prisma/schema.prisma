generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String    @unique
  passwordHash    String
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships WorkspaceMember[]
  auditLogs   AuditLog[]
}

enum Plan {
  Free
  Spark
  Blaze
  Ignition
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(Free)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members                 WorkspaceMember[]
  subscription            Subscription?
  customers               Customer[]
  jobs                    Job[]
  assetCategories         AssetCategory[]
  assets                  Asset[]
  routeOptimizationUsages RouteOptimizationUsage[]
  integrations            Integration[]
  auditLogs               AuditLog[]
  routes                  Route[]
  externalEntityLinks     ExternalEntityLink[]
}

enum MemberRole {
  Owner
  Admin
  Member
}

model WorkspaceMember {
  id          String     @id @default(cuid())
  workspaceId String
  userId      String
  role        MemberRole @default(Member)
  permissions Json       @default("{}")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

enum SubscriptionStatus {
  Active
  Trailing
  Due
  Cancelled
}

model Subscription {
  id          String             @id @default(cuid())
  workspaceId String             @unique
  plan        Plan
  status      SubscriptionStatus @default(Active)
  startedAt   DateTime           @default(now())
  endsAt      DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Customer {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  email        String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  province     String?
  postalCode   String?
  country      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  jobs      Job[]
}

enum JobStatus {
  Scheduled
  InProgress
  Delivered
  Completed
  Cancelled
}

model Job {
  id          String    @id @default(cuid())
  workspaceId String
  customerId  String
  title       String
  description String?
  status      JobStatus @default(Scheduled)
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer  Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobAssets JobAsset[]

  @@index([workspaceId])
  @@index([customerId])
  @@index([status])
}

model AssetCategory {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assets    Asset[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

enum AssetType {
  Trackable
  NonTrackable
}

enum AssetStatus {
  Available
  Assigned
  Maintenance
  Damaged
  Retired
}

model Asset {
  id           String      @id @default(cuid())
  workspaceId  String
  categoryId   String
  sequentialId Int
  type         AssetType   @default(NonTrackable)
  status       AssetStatus @default(Available)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  qrCode     String?   @unique
  latitude   Decimal?  @db.Decimal(10, 7)
  longitude  Decimal?  @db.Decimal(10, 7)
  lastSeenAt DateTime?

  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category   AssetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  jobAssets  JobAsset[]
  routeStops RouteStop[]

  @@unique([workspaceId, sequentialId])
  @@index([workspaceId])
  @@index([categoryId])
  @@index([type])
  @@index([status])
}

enum JobAssetStatus {
  Assigned
  PickedUp
  Returned
}

model JobAsset {
  id        String         @id @default(cuid())
  jobId     String
  assetId   String
  status    JobAssetStatus @default(Assigned)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([jobId, assetId])
  @@index([assetId])
}

enum RouteStatus {
  Draft
  Published
}

model Route {
  id          String      @id @default(cuid())
  workspaceId String
  name        String
  status      RouteStatus @default(Draft)
  optimized   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  routeStops RouteStop[]

  @@index([workspaceId])
  @@index([status])
}

model RouteStop {
  id        String   @id @default(cuid())
  routeId   String
  assetId   String
  order     Int
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([routeId, assetId])
  @@unique([routeId, order])
  @@index([routeId])
  @@index([assetId])
}

model RouteOptimizationUsage {
  id          String @id @default(cuid())
  workspaceId String
  month       Int
  year        Int
  count       Int    @default(0)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, month, year])
  @@index([workspaceId])
}

enum IntegrationStatus {
  Error
  Connected
  Disconnected
  Revoked
}

model Integration {
  id          String            @id @default(cuid())
  workspaceId String
  provider    String
  name        String
  status      IntegrationStatus @default(Disconnected)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  externalAccountId String?
  externalName      String?

  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?

  config   Json @default("{}")
  metadata Json @default("{}")

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integrationSyncRuns IntegrationSyncRun[]
  externalEntityLinks ExternalEntityLink[]

  @@index([workspaceId])
  @@index([provider])
  @@index([workspaceId, provider, externalAccountId])
}

enum IntegrationSyncStatus {
  Idle
  Syncing
  Success
  Failed
}

enum SyncDirection {
  Import
  Export
  Dual
}

model IntegrationSyncRun {
  id             String                @id @default(cuid())
  integrationId  String
  status         IntegrationSyncStatus @default(Idle)
  direction      SyncDirection
  startedAt      DateTime              @default(now())
  finishedAt     DateTime?
  recordsRead    Int                   @default(0)
  recordsWritten Int                   @default(0)
  errorMessage   String?
  metadata       Json                  @default("{}")

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId])
  @@index([status])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])

  @@index([workspaceId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model ExternalEntityLink {
  id                 String @id @default(cuid())
  workspaceId        String
  integrationId      String
  localEntityType    String
  localEntityId      String
  externalEntityType String
  externalEntityId   String
  createdAt          String
  updatedAt          String

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, externalEntityType, externalEntityId])
  @@unique([integrationId, localEntityType, localEntityId])
  @@index([workspaceId])
}
